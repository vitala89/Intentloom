{
  "name": "@intentloom/workspace",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs && tsc -b && node scripts/build-cli.mjs && node scripts/build-daemon.mjs && node scripts/build-mcp.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "oxlint",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json,yaml,yml}\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && git diff --check",
    "verify:staged": "node scripts/validate-staged.mjs",
    "validate:commit-range": "node scripts/validate-commit-range.mjs",
    "validate:diff": "node scripts/validate-diff.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "desktop:prepare-sidecar": "node scripts/desktop/prepare-tauri-sidecar.mjs",
    "desktop:package": "node scripts/desktop/package-desktop.mjs",
    "pack:cli": "pnpm --filter ./packages/cli pack --pack-destination ./artifacts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vitepress>vite": ">=6.4.3"
    }
  }
}
