{
  "name": "intentloom",
  "version": "1.0.1",
  "description": "Vendor-neutral CLI that defines, validates, and synchronizes engineering intent across AI coding tools. Local, offline-first, and non-destructive.",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitala89/Intentloom.git"
  },
  "homepage": "https://vitala89.github.io/Intentloom/",
  "bugs": {
    "url": "https://github.com/vitala89/Intentloom/issues"
  },
  "keywords": [
    "agentic-engineering",
    "ai-assisted-development",
    "ai-coding-tools",
    "coding-agents",
    "claude-code",
    "codex",
    "cursor",
    "github-copilot",
    "mcp",
    "developer-tools",
    "engineering-intent",
    "intentloom"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "@intentloom/application": "workspace:*",
    "@intentloom/evidence-analysis": "workspace:*",
    "@intentloom/evidence-git": "workspace:*",
    "@intentloom/evidence-provider": "workspace:*"
  },
  "bin": {
    "intentloom": "dist/intentloom.cjs"
  },
  "files": [
    "dist/intentloom.cjs",
    "dist/catalog",
    "dist/profiles",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
